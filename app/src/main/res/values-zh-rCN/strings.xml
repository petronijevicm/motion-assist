    <string name="preview_guide_title">工作原理</string>
    <string name="preview_guide_body">屏幕边缘的圆点会随您身体感受到的行驶状态移动：转弯时横向移动，刹车时向上，加速时向下。</string>
    <string name="preview_live_title">实时预览</string>
    <string name="preview_live_body">移动或转动手机，观察提示点的反应。您也可以用手指拖动它们。</string>
    <string name="enable_title">运动提示</string>
    <string name="enable_summary">在屏幕边缘显示移动的圆点，缓解晕动症</string>
