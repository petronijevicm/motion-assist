    <string name="responsiveness_title">反応の速さ</string>
    <string name="responsiveness_summary">低いほど穏やかで滑らか、高いほど早く反応します</string>
    <string name="area_title">キューの領域</string>
    <string name="area_summary">キューを表示する左右の帯の幅。最大にすると画面全体に表示します</string>
