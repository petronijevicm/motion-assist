    <string name="preview_guide_title">How it works</string>
    <string name="preview_guide_body">Dots at the edges of the screen move the way your body feels the ride: sideways in turns, up when braking, down when speeding up.</string>
    <string name="preview_live_title">Live preview</string>
    <string name="preview_live_body">Move or turn your phone and watch the cues react. You can also drag them with a finger.</string>
