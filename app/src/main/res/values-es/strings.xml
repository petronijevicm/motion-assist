    <string name="motion_assist_description">Las señales de movimiento para vehículos (Motion Assist) reducen el mareo por movimiento cinetosis al usar el móvil proyectando puntos visuales sincronizados con la inercia real.</string>
    <string name="motion_assist_turn_on">Activar Asistencia de movimiento</string>
