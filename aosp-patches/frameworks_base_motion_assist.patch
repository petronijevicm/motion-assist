diff --git a/packages/SystemUI/src/com/android/systemui/motionassist/MotionAssistController.java b/packages/SystemUI/src/com/android/systemui/motionassist/MotionAssistController.java
new file mode 100644
index 000000000000..5f8bd855d530
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/motionassist/MotionAssistController.java
@@ -0,0 +1,347 @@
+/*
